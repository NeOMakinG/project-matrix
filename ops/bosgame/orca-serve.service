# systemd user unit: headless Orca runtime for Project Matrix on bosgame.
# Install: cp ops/bosgame/orca-serve.service ~/.config/systemd/user/ && systemctl --user daemon-reload
[Unit]
Description=Orca runtime (headless) for Project Matrix
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Pairing advertises the Tailscale name only; nothing is exposed on public interfaces by Matrix.
Environment=ORCA_PORT=7420
EnvironmentFile=-%h/.config/matrix/orca-serve.env
ExecStart=/usr/bin/orca serve --port ${ORCA_PORT} --pairing-address ${ORCA_PAIRING_ADDRESS} --project-root %h/matrix/projects
Restart=on-failure
RestartSec=5
# `orca serve` has no bind-address flag (only --port and --pairing-address), so restrict who can
# connect: loopback and the tailnet only. The host firewall rule in orca-serve.md is the primary
# control; these directives are defence in depth where the user manager supports IP filtering.
IPAddressDeny=any
IPAddressAllow=localhost 100.64.0.0/10 fd7a:115c:a1e0::/48
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
