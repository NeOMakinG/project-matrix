# Runner image for Project Matrix agent runs. Contains coding CLIs and toolchains only; no credentials.
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates curl unzip ripgrep jq python3 \
  && rm -rf /var/lib/apt/lists/*

ARG BUN_VERSION=1.3.9
ARG BUN_SHA256
RUN test "${BUN_VERSION}" = "1.3.9" \
  && test "${#BUN_SHA256}" = 64 \
  && printf '%s' "${BUN_SHA256}" | grep -Eq '^[0-9a-f]{64}$' \
  && case "$(uname -m)" in x86_64) arch=x64;; aarch64) arch=aarch64;; *) exit 1;; esac \
  && curl --fail --location --proto '=https' --tlsv1.2 \
    "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${arch}.zip" -o /tmp/bun.zip \
  && printf '%s  /tmp/bun.zip\n' "${BUN_SHA256}" | sha256sum --check --strict \
  && unzip -q /tmp/bun.zip -d /tmp/bun \
  && install -m 755 "/tmp/bun/bun-linux-${arch}/bun" /usr/local/bin/bun \
  && test "$(bun --version)" = "${BUN_VERSION}" \
  && rm -rf /tmp/bun /tmp/bun.zip

ARG CLAUDE_CODE_VERSION=latest
ARG CODEX_VERSION=latest
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "@openai/codex@${CODEX_VERSION}" \
  && npm cache clean --force

RUN mkdir -p /work /run/matrix /opt/matrix
WORKDIR /work
